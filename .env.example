# Copy to .env and adjust if not using the default local XAMPP MariaDB instance.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=saas_revenue_forecast

# Required for the dashboard's "Generate insights with Claude" button.
ANTHROPIC_API_KEY=

# Required for the floating chatbot (bottom-right, all pages). Never exposed
# to the browser — read server-side only, by src/groq_client.py.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
